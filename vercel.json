{
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*).pdf",
            "headers": [
                {
                    "key": "Content-Disposition",
                    "value": "inline"
                },
                {
                    "key": "Content-Type",
                    "value": "application/pdf"
                },
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                }
            ]
        }
    ]
}